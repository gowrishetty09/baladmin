{
  "cli": {
    "version": ">= 11.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_ANDROID_KEYSTORE": "false"
        }
      },
      "ios": {
        "simulator": false,
        "env": {
          "EXPO_IOS_ENTERPRISE_FREEBIES": false
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "env": {
          "EXPO_ANDROID_KEYSTORE": "false"
        }
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_IOS_ENTERPRISE_FREEBIES": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
